# /etc/config/ap6 - cau hinh UCI cho service ap6d (Bao cao muc 14.2, 16.2)
#
# UCI (Unified Configuration Interface) la cach OpenWrt luu cau hinh cho
# network, wireless, firewall, dhcp... Web UI (LuCI) va CLI deu doc/ghi qua
# UCI, sau do service duoc reload.
#
#   uci show ap6
#   uci set ap6.main.tcp_port=9000
#   uci commit ap6            # -> procd trigger reload service ap6d
#
# Luong day du tren thiet bi:
#   LuCI/CLI -> UCI -> init script -> apd -> ioctl/iwpriv -> driver Wi-Fi

config ap6d 'main'
	option enabled '1'
	# 0 = chi mo Unix domain socket (an toan hon tren san pham);
	# khac 0 = mo them TCP control port tren loopback de debug
	option tcp_port '0'
	option profile '/etc/ap6/ap6.dat'
	option log_level 'info'

# Cac tham so nay duoc script chuyen thanh profile MediaTek tuong ung
config wifi 'radio0'
	option ssid 'Viettel_AP6'
	option channel '6'
	option txpower '100'
	option country 'VN'
	option encryption 'WPA2PSK'
	option hidden '0'
